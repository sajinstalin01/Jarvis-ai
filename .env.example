# Copy to .env and add your own keys. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set true to enable spoken replies; requires working audio output
JARVIS_SPEAK_RESPONSES=false

# ElevenLabs API (key can also be entered via "elevenlabs configure")
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: use ElevenLabs for JARVIS replies (default: pyttsx3)
JARVIS_TTS_PROVIDER=pyttsx3
# Optional: google (default) or elevenlabs; ElevenLabs uploads microphone audio for transcription
JARVIS_STT_PROVIDER=google
