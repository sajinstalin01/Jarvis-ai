# Copy to .env and add your own keys. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set true to enable spoken replies; requires working audio output
JARVIS_SPEAK_RESPONSES=false
# Optional local voice transcription (requires: pip install faster-whisper)
JARVIS_STT_PROVIDER=google
JARVIS_WHISPER_MODEL=base
# Optional HTTPS companion server for LAN pairing; use a trusted cert/key pair.
# JARVIS_TLS_CERT=C:\\path\\to\\cert.pem
# JARVIS_TLS_KEY=C:\\path\\to\\key.pem

